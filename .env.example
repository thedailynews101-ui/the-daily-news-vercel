PORT=5000
NODE_ENV=development

# Runtime connection used by Prisma Client (pooled URL is fine here).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional: direct/unpooled connection used by the Prisma CLI for migrations.
# Leave unset to reuse DATABASE_URL.
DIRECT_URL=

# URL of the frontend app. Used for CORS (credentialed requests) and for
# building email verification / password reset links.
CLIENT_URL=http://localhost:3000

# --- Auth ---------------------------------------------------------------
# Generate strong random values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Mail (SMTP) ----------------------------------------------------------
# Leave these unset in development: verification/reset links are logged to
# the console instead of being emailed.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=The Daily News <no-reply@dailynews.local>
